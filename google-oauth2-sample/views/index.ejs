<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<body>
  <% if (!user) { %>
    <a href="/auth/google" class="google-btn">
      <img src="google-icon.png" alt="Google logo">
      Sign in with Google
    </a>
  <% } else { %>
    <p>Welcome <%= user.displayName %>!</p>
    <a href="/logout">Logout</a>
  <% } %>
</body>
</html>
